{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lastfm_track_stats",
  "description": "A track's cumulative Last.fm listeners and scrobbles on a snapshot date. Source: artist.getTopTracks.",
  "type": "object",
  "required": ["snapshot_date", "artist", "track", "rank", "listeners", "playcount"],
  "properties": {
    "snapshot_date": {"type": "string", "format": "date"},
    "artist": {"type": "string", "enum": ["twice", "misamo", "nayeon", "jihyo", "chaeyoung", "tzuyu", "nmixx", "triples", "triples-aaa", "triples-kre", "triples-lovelution", "triples-evolution", "triples-aria", "triples-vv", "triples-infinity", "triples-msnz-sun", "triples-msnz-moon", "triples-msnz-neptune", "triples-msnz-zenith"]},
    "track": {"type": "string", "minLength": 1},
    "track_mbid": {"type": ["string", "null"]},
    "rank": {"type": "integer", "minimum": 1},
    "listeners": {"type": "integer", "minimum": 0},
    "playcount": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
